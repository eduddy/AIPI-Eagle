CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

# PSRAM: assumes an N16R8 module (16MB flash / 8MB octal PSRAM), the usual
# fit for XiaoZhi-class hardware. If boot fails with a PSRAM ID error, the
# module has quad PSRAM: replace CONFIG_SPIRAM_MODE_OCT with
# CONFIG_SPIRAM_MODE_QUAD. ESP-Claw requires 8MB PSRAM either way.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Console over the USB-C port (same port used for flashing)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
